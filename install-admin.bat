// mencatat hash versi yang ia pasang di .w3study-custom.json; kalau file itu kemudian
// kamu ubah atau hapus, menjalankan ulang installer TIDAK menimpanya lagi.
const CUSTOMIZABLE = ["src/app/favicon.ico", "src/app/icon.svg", "src/app/apple-icon.png", "src/app/brand.jsx"];
const RECORD = ".w3study-custom.json";
// File CSS komponen animasi: dibuat hanya kalau belum ada (kamu mungkin sudah punya dari sumbernya).
const IF_MISSING = ["src/app/components/CrystalizedBall.css", "src/app/components/TechText.css", "src/app/components/FluxLines.css"];
// File integrasi yang bergantung pada komponen buatan kamu: dipasang hanya kalau komponennya sudah ada.
const GATED = {
  "src/app/components/HomeHero.jsx": "src/app/components/TechText.jsx",
  "src/app/components/ModuleBankBanner.jsx": "src/app/components/FluxLines.jsx",
};
const sha = (buf) => require("crypto").createHash("sha256").update(buf).digest("hex");

function installFiles() {
  console.log("\n2) Menulis file sistem admin...");
  let rec = {};
  try {
    rec = JSON.parse(fs.readFileSync(abs(RECORD), "utf8"));
  } catch (e) {}
  let recChanged = false;
  for (const [rel, b64] of Object.entries(FILES)) {
    const buf = Buffer.from(b64, "base64");
    try {
      if (IF_MISSING.includes(rel) && exists(rel)) {
        note("SKIP", rel + " (sudah ada - versimu dipertahankan)");
        continue;
      }
      if (GATED[rel] && !exists(GATED[rel])) {
        note("WARN", rel + " dilewati: " + GATED[rel] + " belum ada (simpan file komponen itu, lalu jalankan ulang installer)");
        continue;
      }
      const custom = CUSTOMIZABLE.includes(rel);
      if (custom && !exists(rel) && rec[rel]) {
        note("SKIP", rel + " (sengaja kamu hapus - tidak dibuat ulang)");
        continue;
      }
      if (exists(rel)) {
        const cur = fs.readFileSync(abs(rel));
        if (cur.equals(buf)) {
          if (custom && rec[rel] !== sha(buf)) {
            rec[rel] = sha(buf);
            recChanged = true;
          }
          note("SKIP", rel + " (sudah terbaru)");
          continue;
        }
        if (custom && rec[rel] && rec[rel] !== sha(cur)) {
          note("SKIP", rel + " (versi kustom milikmu dipertahankan)");
          continue;
        }
        backup(rel);
      }
      fs.mkdirSync(path.dirname(abs(rel)), { recursive: true });
      fs.writeFileSync(abs(rel), buf);
      if (custom) {
        rec[rel] = sha(buf);
        recChanged = true;
      }
      note("OK", rel);
    } catch (e) {
      note("GAGAL", rel + " - " + e.message);
    }
  }
  if (recChanged) fs.writeFileSync(abs(RECORD), JSON.stringify(rec, null, 2) + "\n");
}

