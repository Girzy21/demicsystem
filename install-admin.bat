const results = [];
function note(kind, msg) {
  results.push(kind);
  console.log("  [" + kind + "] " + msg);
}
const abs = (rel) => path.join(ROOT, ...rel.split("/"));
const exists = (rel) => fs.existsSync(abs(rel));

function readText(rel) {
  let raw = fs.readFileSync(abs(rel), "utf8");
  const bom = raw.charCodeAt(0) === 0xfeff;
  if (bom) raw = raw.slice(1);
  return { text: raw.replace(/\r\n/g, "\n"), crlf: raw.includes("\r\n"), bom };
}
function writeText(rel, text, meta) {
  let out = text;
  if (meta.crlf) out = out.replace(/\n/g, "\r\n");
  if (meta.bom) out = "\uFEFF" + out;
  fs.mkdirSync(path.dirname(abs(rel)), { recursive: true });
  fs.writeFileSync(abs(rel), out, "utf8");
}

let backupDir = null;
function backup(rel) {
  if (!exists(rel)) return;
  if (!backupDir) {
    const d = new Date();
    const p = (n) => String(n).padStart(2, "0");
    backupDir = "_admin-backup-" + d.getFullYear() + p(d.getMonth() + 1) + p(d.getDate()) + "-" + p(d.getHours()) + p(d.getMinutes()) + p(d.getSeconds());
  }
  const dest = path.join(ROOT, backupDir, ...rel.split("/"));
  fs.mkdirSync(path.dirname(dest), { recursive: true });
  fs.copyFileSync(abs(rel), dest);
}

const balance = (s) => (s.match(/\{/g) || []).length - (s.match(/\}/g) || []).length;

// ---------------------------------------------------------------- 1. preflight
function findLib(base) {
  for (const ext of [".js", ".jsx", ".ts", ".tsx", ".mjs"]) if (exists(base + ext)) return base + ext;
  return null;
}
function preflight() {
  console.log("\n1) Memeriksa proyek di: " + ROOT);
  if (!exists("package.json") || !exists("src/app")) {
    console.log("\n[GAGAL] package.json / src/app tidak ditemukan. Letakkan file ini di folder ROOT demicsystem lalu jalankan lagi.");
    process.exit(1);
  }
  const major = parseInt(process.versions.node.split(".")[0], 10);
  if (major < 18) note("WARN", "Node " + process.versions.node + " (disarankan 18+)");
  if (!exists("src/app/api")) note("WARN", "src/app/api tidak ada — route baru tetap dibuat di sana");

  const libs = [
    ["src/lib/supabaseAdmin", ["supabaseAdmin"]],
    ["src/lib/supabaseClient", ["supabase"]],
    ["src/lib/cloudinary", ["cloudinary"]],
    ["src/lib/embeddings", ["embedModule", "embedForumPost", "isEmbeddingConfigured"]],
    ["src/lib/moduleTagging", ["runModuleTagging", "CURRENT_AI_ANALYSIS_VERSION"]],
  ];
  let libOk = true;
  for (const [base, names] of libs) {
    const f = findLib(base);
    if (!f) {
      note("WARN", base + ".* tidak ditemukan — dibutuhkan panel admin");
      libOk = false;
      continue;
    }
    const src = fs.readFileSync(abs(f), "utf8");
    const missing = names.filter((n) => !new RegExp("\\b" + n + "\\b").test(src));
    if (missing.length) {
      note("WARN", f + " tidak mengekspor: " + missing.join(", "));
      libOk = false;
    }
  }
  if (libOk) note("OK", "semua file lib yang dibutuhkan ditemukan");
  if (!exists("src/app/components/Homepage.jsx")) note("WARN", "src/app/components/Homepage.jsx tidak ditemukan (patch Homepage dilewati)");
}

