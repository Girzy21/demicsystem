    t = out;
    changed = true;
    note("OK", "Homepage.jsx - " + e.name);
  }
  if (!changed) return;
  for (const line of CHAT_IMPORTS) if (!t.includes(line)) t = insertBeforeFirstImport(t, line);
  if (balance(t) !== balance(meta.text)) {
    note("GAGAL", "Homepage.jsx - hasil Diskusi Chat tidak seimbang, TIDAK ditulis");
    return;
  }
  backup(rel);
  writeText(rel, t, meta);
}


// ---------------------------------------------------------------- 8. Beranda, Bank Modul, animasi login
function runEditsOn(rel, edits, importsFor) {
  const meta = readText(rel);
  let t = meta.text;
  const applied = [];
  for (const e of edits) {
    if (e.done(t)) {
      note("SKIP", rel + " - " + e.name + " (sudah)");
      continue;
    }
    const out = e.apply(t);
    if (out === null || out === t) {
      note("GAGAL", rel + " - " + e.name + ": pola kode tidak cocok (file berbeda dari versi yang saya lihat)");
      continue;
    }
    t = out;
    applied.push(e.id);
    note("OK", rel + " - " + e.name);
  }
  if (applied.length === 0) return;
  for (const line of importsFor(applied)) if (!t.includes(line)) t = insertBeforeFirstImport(t, line);
  if (balance(t) !== balance(meta.text)) {
    note("GAGAL", rel + " - hasil tidak seimbang, TIDAK ditulis");
    return;
  }
  backup(rel);
  writeText(rel, t, meta);
}

function patchLanding() {
  const rel = "src/app/components/Homepage.jsx";
  if (!exists(rel)) {
    note("SKIP", "beranda & Bank Modul (Homepage.jsx tidak ditemukan)");
    return;
  }
  const hasTech = exists("src/app/components/TechText.jsx");
  const hasFlux = exists("src/app/components/FluxLines.jsx");
  const edits = [
    {
      id: "banner",
      name: "FYI etika AI dipindah ke bawah kolom cari",
      done: (t) => t.includes("<AiEthicsBanner ctx={ctx} embedded />"),
      apply: (t) => {
        let out = once(t, /function AiEthicsBanner\(\{ ctx \}\) \{/, "function AiEthicsBanner({ ctx, embedded }) {");
        if (out === null) return null;
        out = once(out, /(function AiEthicsBanner[\s\S]*?)<div style=\{\{ padding: "6px 32px 0" \}\}>/, '$1<div style={{ padding: embedded ? 0 : "6px 32px 0" }}>');
        if (out === null) return null;
        out = inFunction(out, "function SearchHub(", (seg) => once(seg, /([ \t]*)\{\/\* results \*\/\}/, "$1<AiEthicsBanner ctx={ctx} embedded />\n\n$1{/* results */}"));
        if (out === null) return null;
        return once(out, /<AiEthicsBanner ctx=\{ctx\} \/>\s*<SearchHub ctx=\{ctx\} \/>/, "<SearchHub ctx={ctx} />");
      },
    },
  ];
  if (hasTech) {
    edits.push({
      id: "hero",
      name: "judul beranda w3study (TechText)",
      done: (t) => t.includes("<HomeHero"),
      apply: (t) => once(t, /(\{activeNav === "home" && \(\s*<div style=\{\{ paddingBottom: 32 \}\}>\s*)(<SearchHub ctx=\{ctx\} \/>)/, "$1<HomeHero ctx={ctx} />\n            $2"),
    });
  } else {
    note("WARN", "judul beranda dilewati: src/app/components/TechText.jsx belum ada (simpan file komponen TechText, lalu jalankan ulang installer)");
  }
  if (hasFlux) {
    edits.push({
      id: "flux",
      name: "banner Bank Modul (FluxLines)",
      done: (t) => t.includes("<ModuleBankBanner"),
      apply: (t) =>
        inFunction(t, "function BankModulSection(", (seg) =>
          once(seg, /(return \(\s*<>\s*)(<Breadcrumb ctx=\{ctx\} \/>)/, "$1{showFolders && <ModuleBankBanner ctx={ctx} count={localModules.length} loading={modulesLoading} />}\n      $2")
        ),
    });
  } else {
    note("WARN", "banner Bank Modul dilewati: src/app/components/FluxLines.jsx belum ada (simpan file komponen FluxLines, lalu jalankan ulang installer)");
  }
  runEditsOn(rel, edits, (applied) => {
    const lines = [];
    if (applied.includes("hero")) lines.push('import HomeHero from "./HomeHero";');
    if (applied.includes("flux")) lines.push('import ModuleBankBanner from "./ModuleBankBanner";');
    return lines;
  });
}

function patchLoginBall() {
  const loginRel = findLoginFile();
  if (!loginRel) {
    note("WARN", "file login tidak ditemukan otomatis - animasi bola kristal di halaman login dilewati");
    return;
  }
  if (!exists("src/app/components/CrystalizedBall.jsx")) {
    note("WARN", "animasi login dilewati: src/app/components/CrystalizedBall.jsx belum ada (simpan file komponen CrystalizedBall, lalu jalankan ulang installer)");
    return;
  }
  let importPath = path.relative(path.dirname(abs(loginRel)), abs("src/app/components/CrystalizedBall")).replace(/\\/g, "/");
  if (!importPath.startsWith(".")) importPath = "./" + importPath;
  runEditsOn(
    loginRel,
    [
      {
        id: "ball",
        name: "bola kristal mengisi slot animasi",
        done: (t) => t.includes("<CrystalizedBall"),
        apply: (t) =>
          once(t, /([ \t]*)\{\/\* decorative glow accents, in place of a real video\/image \*\/\}/, (m, ind) =>
            [
              ind + "{/* Animasi: CrystalizedBall */}",
              ind + '<div style={{ position: "absolute", inset: 0, pointerEvents: "none" }}>',
              ind + '  <CrystalizedBall preset="abyss" color="#2C7BE5" theme="light" size={0.74} />',
              ind + "</div>",
              ind + "{/* decorative glow accents */}",
            ].join("\n")
          ),
      },
      {
        id: "badge",
        name: "label slot video -> w3study",
        done: (t) => !t.includes("Slot video"),
        apply: (t) => once(t, /\u25B6 Slot video/, "\u2726 w3study"),
      },
      {
        id: "copy",
        name: "teks placeholder -> deskripsi",
        done: (t) => !t.includes("Ganti area ini dengan tag"),
        apply: (t) => once(t, /Ganti area ini dengan tag\s*<code[^>]*>[\s\S]*?<\/code>[^<]*/, "Modul, diskusi, dan teman belajar dalam satu ekosistem sekolah."),
      },
      {
        id: "arrows",
        name: "hapus tombol panah carousel placeholder",
        done: (t) => !/zIndex: 1, display: "flex", gap: 10/.test(t),
        apply: (t) => once(t, /\n?[ \t]*<div style=\{\{ position: "relative", zIndex: 1, display: "flex", gap: 10 \}\}>\s*<div style=\{\{[^\n]*\}\}>\s*\u2039\s*<\/div>\s*<div style=\{\{[^\n]*\}\}>\s*\u203A\s*<\/div>\s*<\/div>/, ""),
      },
    ],
    (applied) => (applied.includes("ball") ? ['import CrystalizedBall from "' + importPath + '";'] : [])
  );
}

// CrystalizedBall memakai paket 'ogl'.
function ensureOgl() {
  if (!exists("src/app/components/CrystalizedBall.jsx")) return;
  let pkg;
  try {
    pkg = JSON.parse(fs.readFileSync(abs("package.json"), "utf8"));
  } catch (e) {
    note("WARN", "package.json tidak terbaca - pasang manual: npm install ogl");
    return;
  }
  if ((pkg.dependencies && pkg.dependencies.ogl) || (pkg.devDependencies && pkg.devDependencies.ogl)) {
    note("SKIP", "paket ogl (sudah terpasang)");
    return;
  }
  console.log("   Memasang paket 'ogl' (dibutuhkan CrystalizedBall)...");
  const r = require("child_process").spawnSync("npm install ogl", { cwd: ROOT, stdio: "inherit", shell: true, timeout: 300000 });
  if (r.status === 0) note("OK", "paket ogl terpasang (package.json dan package-lock.json ikut berubah: commit keduanya)");
  else note("WARN", "gagal memasang ogl otomatis - jalankan manual: npm install ogl");
}

function ask(question, def) {
  return new Promise((resolve) => {
    if (!process.stdin.isTTY) return resolve(def);
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    rl.question(question, (a) => {
      rl.close();
      const t = a.trim().toLowerCase();
      resolve(t === "" ? def : t === "y" || t === "ya");
    });
  });
}

