  name: "font Inter + Space Grotesk",
  done: (t) => t.includes("SANS_STACK"),
  apply: (t) => {
    if (!t.includes(SANS_LITERAL) && !t.includes(SERIF_LITERAL)) return null;
    return t.split(SANS_LITERAL).join("SANS_STACK").split(SERIF_LITERAL).join("HEADING_STACK");
  },
};
