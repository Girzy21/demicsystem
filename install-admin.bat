"use strict";
// ======================================================================
// INSTALLER SISTEM ADMIN (sekali klik) — dijalankan dari folder root demicsystem.
//  - Menulis file baru (lib, halaman /admin, route /api/admin/*)
//  - Menambal route lama (tolak akun ditangguhkan, batas panjang, dll.)
//  - Mencadangkan semua file yang diubah ke _admin-backup-<waktu>/
//  - Aman dijalankan berulang (idempoten).
// ======================================================================
const fs = require("fs");
const path = require("path");
const readline = require("readline");

const ROOT = process.cwd();
const FILES = {
 "src/app/admin/page.jsx": "",
 "src/app/admin/layout.jsx": "",
 "src/app/api/admin/modules/[id]/route.js": "",
 "src/app/api/admin/users/route.js": "",
 "src/app/api/admin/users/[id]/route.js": "",
 "src/app/api/admin/stats/route.js": "",
 "src/app/api/admin/review/route.js": "",
 "src/app/api/admin/topics/route.js": "",
 "src/app/api/admin/me/route.js": "",
 "src/app/api/admin/audit/route.js": "",
 "src/app/api/admin/content/route.js": "",
 "src/app/api/admin/maintenance/route.js": "",
 "src/lib/adminAuth.js": "",
 "src/lib/adminContent.js": "",
 "admin-setup/admin_setup.sql": ""
};

const results = [];
function note(kind, msg) {
  results.push(kind);
  console.log("  [" + kind + "] " + msg);
}
const abs = (rel) => path.join(ROOT, ...rel.split("/"));
const exists = (rel) => fs.existsSync(abs(rel));

function readText(rel) {
  let raw = fs.readFileSync(abs(rel), "utf8");
  const bom = raw.charCodeAt(0) === 0xfeff;
  if (bom) raw = raw.slice(1);
  return { text: raw.replace(/\r\n/g, "\n"), crlf: raw.includes("\r\n"), bom };
}
function writeText(rel, text, meta) {
  let out = text;
  if (meta.crlf) out = out.replace(/\n/g, "\r\n");
  if (meta.bom) out = "\uFEFF" + out;
  fs.mkdirSync(path.dirname(abs(rel)), { recursive: true });
  fs.writeFileSync(abs(rel), out, "utf8");
}

let backupDir = null;
function backup(rel) {
  if (!exists(rel)) return;
  if (!backupDir) {
    const d = new Date();
    const p = (n) => String(n).padStart(2, "0");
    backupDir = "_admin-backup-" + d.getFullYear() + p(d.getMonth() + 1) + p(d.getDate()) + "-" + p(d.getHours()) + p(d.getMinutes()) + p(d.getSeconds());
  }
  const dest = path.join(ROOT, backupDir, ...rel.split("/"));
  fs.mkdirSync(path.dirname(dest), { recursive: true });
  fs.copyFileSync(abs(rel), dest);
}

const balance = (s) => (s.match(/\{/g) || []).length - (s.match(/\}/g) || []).length;

// ---------------------------------------------------------------- 1. preflight
function findLib(base) {
  for (const ext of [".js", ".jsx", ".ts", ".tsx", ".mjs"]) if (exists(base + ext)) return base + ext;
  return null;
}
function preflight() {
  console.log("\n1) Memeriksa proyek di: " + ROOT);
  if (!exists("package.json") || !exists("src/app")) {
    console.log("\n[GAGAL] package.json / src/app tidak ditemukan. Letakkan file ini di folder ROOT demicsystem lalu jalankan lagi.");
    process.exit(1);
  }
  const major = parseInt(process.versions.node.split(".")[0], 10);
  if (major < 18) note("WARN", "Node " + process.versions.node + " (disarankan 18+)");
  if (!exists("src/app/api")) note("WARN", "src/app/api tidak ada — route baru tetap dibuat di sana");

  const libs = [
    ["src/lib/supabaseAdmin", ["supabaseAdmin"]],
    ["src/lib/supabaseClient", ["supabase"]],
    ["src/lib/cloudinary", ["cloudinary"]],
    ["src/lib/embeddings", ["embedModule", "embedForumPost", "isEmbeddingConfigured"]],
    ["src/lib/moduleTagging", ["runModuleTagging", "CURRENT_AI_ANALYSIS_VERSION"]],
  ];
  let libOk = true;
  for (const [base, names] of libs) {
    const f = findLib(base);
    if (!f) {
      note("WARN", base + ".* tidak ditemukan — dibutuhkan panel admin");
      libOk = false;
      continue;
    }
    const src = fs.readFileSync(abs(f), "utf8");
    const missing = names.filter((n) => !new RegExp("\\b" + n + "\\b").test(src));
    if (missing.length) {
      note("WARN", f + " tidak mengekspor: " + missing.join(", "));
      libOk = false;
    }
  }
  if (libOk) note("OK", "semua file lib yang dibutuhkan ditemukan");
  if (!exists("src/app/components/Homepage.jsx")) note("WARN", "src/app/components/Homepage.jsx tidak ditemukan (patch Homepage dilewati)");
}

// ---------------------------------------------------------------- 2. file baru
function installFiles() {
  console.log("\n2) Menulis file sistem admin...");
  for (const [rel, b64] of Object.entries(FILES)) {
    const buf = Buffer.from(b64, "base64");
    try {
      if (exists(rel)) {
        if (fs.readFileSync(abs(rel)).equals(buf)) {
          note("SKIP", rel + " (sudah terbaru)");
          continue;
        }
        backup(rel);
      }
      fs.mkdirSync(path.dirname(abs(rel)), { recursive: true });
      fs.writeFileSync(abs(rel), buf);
      note("OK", rel);
    } catch (e) {
      note("GAGAL", rel + " — " + e.message);
    }
  }
}

// ---------------------------------------------------------------- 3. patch route lama
const INLINE = /if \(authError \|\| !user\) \{\s*return NextResponse\.json\([^;]*\);\s*\}/;
const HELPER = /if \(authFail\) return authFail;/;
const LIKES = /if \(!userId\) \{\s*return NextResponse\.json\([^;]*\);\s*\}/;

const guard = (v) => (ind) => "\n\n" + ind + "const blocked = await assertActive(" + v + ");\n" + ind + "if (blocked) return blocked;";
const guardStep = (fn, anchor, v) => ({ fn, anchor, done: "assertActive(", insert: guard(v), label: fn + ": tolak akun ditangguhkan" });
const lengthStep = (anchor, max, what) => ({
  fn: "POST",
  anchor,
  done: "maksimal " + max + " karakter",
  label: "POST: batas " + max + " karakter",
  insert: (ind) => "\n\n" + ind + "if (body.length > " + max + ") {\n" + ind + "  return NextResponse.json({ error: \"Isi " + what + " maksimal " + max + " karakter.\" }, { status: 400 });\n" + ind + "}",
});
const EMPTY_POST = /if \(!body\) \{\s*return NextResponse\.json\(\{ error: "Isi post tidak boleh kosong\." \}, \{ status: 400 \}\);\s*\}/;
const EMPTY_REPLY = /if \(!body\) \{\s*return NextResponse\.json\(\{ error: "Isi balasan tidak boleh kosong\." \}, \{ status: 400 \}\);\s*\}/;

const suggestStep = {
  fn: "POST",
  anchor: INLINE,
  done: "getAccess(",
  label: "POST: batasi ke pengunggah/admin + tolak akun ditangguhkan",
  insert: (ind) =>
    [
      "",
      "",
      ind + "const blocked = await assertActive(user.id);",
      ind + "if (blocked) return blocked;",
      "",
      ind + "// Hanya pengunggah modul (atau admin) yang boleh memicu analisis AI.",
      ind + "const { data: ownerRow } = await supabaseAdmin.from(\"modules\").select(\"uploader_id\").eq(\"id\", id).maybeSingle();",
      ind + "if (!ownerRow) return NextResponse.json({ error: \"Modul tidak ditemukan.\" }, { status: 404 });",
      ind + "if (ownerRow.uploader_id !== user.id) {",
      ind + "  const access = await getAccess(user.id);",
      ind + "  if (!access || !access.is_admin) {",
      ind + "    return NextResponse.json({ error: \"Hanya pengunggah modul yang bisa memicu analisis.\" }, { status: 403 });",
      ind + "  }",
      ind + "}",
    ].join("\n"),
};

const PATCHES = [
  { file: "src/app/api/forum/posts/route.js", imports: ["assertActive"], steps: [guardStep("POST", INLINE, "user.id"), lengthStep(EMPTY_POST, 5000, "post")] },
  { file: "src/app/api/forum/replies/route.js", imports: ["assertActive"], steps: [guardStep("POST", INLINE, "user.id"), lengthStep(EMPTY_REPLY, 3000, "balasan")] },
  { file: "src/app/api/modules/route.js", imports: ["assertActive"], steps: [guardStep("POST", INLINE, "user.id")] },
  { file: "src/app/api/cloudinary-signature/route.js", imports: ["assertActive"], steps: [guardStep("POST", INLINE, "user.id")] },
  { file: "src/app/api/profile/route.js", imports: ["assertActive"], steps: [guardStep("PATCH", INLINE, "user.id")] },
  { file: "src/app/api/profile/photo/route.js", imports: ["assertActive"], steps: [guardStep("POST", HELPER, "user.id")] },
  { file: "src/app/api/forum/posts/[id]/route.js", imports: ["assertActive"], steps: [guardStep("PATCH", HELPER, "user.id")] },
  { file: "src/app/api/forum/replies/[id]/route.js", imports: ["assertActive"], steps: [guardStep("PATCH", HELPER, "user.id")] },
  { file: "src/app/api/modules/[id]/route.js", imports: ["assertActive"], steps: [guardStep("PATCH", HELPER, "user.id")] },
  { file: "src/app/api/forum/likes/route.js", imports: ["assertActive"], steps: [guardStep("POST", LIKES, "userId")] },
  { file: "src/app/api/modules/[id]/suggest-tags/route.js", imports: ["assertActive", "getAccess"], steps: [suggestStep] },
];

function addImport(text, names) {
  const re = /^import \{([^}]*)\} from "@\/lib\/adminAuth";[ \t]*$/m;
  const m = re.exec(text);
  if (m) {
    const have = m[1].split(",").map((s) => s.trim()).filter(Boolean);
    const all = Array.from(new Set(have.concat(names)));
    return text.replace(m[0], "import { " + all.join(", ") + " } from \"@/lib/adminAuth\";");
  }
  const line = "import { " + names.join(", ") + " } from \"@/lib/adminAuth\";";
  const first = text.search(/^import /m);
  return first < 0 ? line + "\n" + text : text.slice(0, first) + line + "\n" + text.slice(first);
}

function applyStep(text, step) {
  const start = text.search(new RegExp("export async function " + step.fn + "\\s*\\("));
  if (start < 0) return { status: "missing", why: "fungsi " + step.fn + " tidak ditemukan" };
  const nextExport = text.indexOf("\nexport ", start + 10);
  const body = text.slice(start, nextExport < 0 ? text.length : nextExport);
  if (body.includes(step.done)) return { status: "already" };
  const m = step.anchor.exec(body);
  if (!m) return { status: "missing", why: "pola kode tidak cocok (file berbeda dari versi yang saya lihat)" };
  const absStart = start + m.index;
  const insertAt = absStart + m[0].length;
  const lineStart = text.lastIndexOf("\n", absStart) + 1;
  const indent = text.slice(lineStart).match(/^[ \t]*/)[0];
  return { status: "patched", text: text.slice(0, insertAt) + step.insert(indent) + text.slice(insertAt) };
}

function patchRoutes() {
  console.log("\n3) Menambal route yang sudah ada...");
  for (const p of PATCHES) {
    if (!exists(p.file)) {
      note("SKIP", p.file + " (tidak ada)");
      continue;
    }
    try {
      const meta = readText(p.file);
      let text = meta.text;
      let changed = false;
      for (const step of p.steps) {
        const r = applyStep(text, step);
        if (r.status === "patched") {
          text = r.text;
          changed = true;
          note("OK", p.file + " - " + step.label);
        } else if (r.status === "already") note("SKIP", p.file + " - " + step.label + " (sudah ada)");
        else note("GAGAL", p.file + " - " + step.label + ": " + r.why);
      }
      if (!changed) continue;
      text = addImport(text, p.imports);
      if (balance(text) !== balance(meta.text)) {
        note("GAGAL", p.file + " - hasil patch tidak seimbang, TIDAK ditulis");
        continue;
      }
      backup(p.file);
      writeText(p.file, text, meta);
    } catch (e) {
      note("GAGAL", p.file + " - " + e.message);
    }
  }
}

// ---------------------------------------------------------------- 4. kunci GET /api/modules (berpasangan dengan Homepage)
function lockModules() {
  const routeRel = "src/app/api/modules/route.js";
  const homeRel = "src/app/components/Homepage.jsx";
  if (!exists(routeRel) || !exists(homeRel)) {
    note("SKIP", "kunci GET /api/modules (route atau Homepage tidak ditemukan)");
    return;
  }
  const route = readText(routeRel);
  const home = readText(homeRel);
  const routeDone = /export async function GET\(request\)[\s\S]*?authToken/.test(route.text);
  const homeDone = home.text.includes('fetch("/api/modules", { headers');
  if (routeDone && homeDone) {
    note("SKIP", "kunci GET /api/modules (sudah diterapkan)");
    return;
  }
  const getRe = /export async function GET\(\)\s*\{\s*try \{/;
  const fetchOld = 'const res = await fetch("/api/modules");';
  if (!getRe.test(route.text) || home.text.split(fetchOld).length !== 2) {
    note("GAGAL", "kunci GET /api/modules dilewati: pola kode tidak cocok (route dan Homepage harus diubah bersamaan)");
    return;
  }
  const newGet = [
    "export async function GET(request) {",
    "  try {",
    "    // Wajib login: Homepage mengirim token Supabase (lihat fetchModules).",
    "    const authToken = (request.headers.get(\"authorization\") || \"\").replace(/^Bearer\\s+/i, \"\");",
    "    if (!authToken) {",
    "      return NextResponse.json({ error: \"Tidak ada token autentikasi.\" }, { status: 401 });",
    "    }",
    "    const {",
    "      data: { user: authUser },",
    "      error: authErr,",
    "    } = await supabaseAdmin.auth.getUser(authToken);",
    "    if (authErr || !authUser) {",
    "      return NextResponse.json({ error: \"Sesi tidak valid — coba login ulang.\" }, { status: 401 });",
    "    }",
  ].join("\n");
  const newFetch = [
    "const {",
    "        data: { session },",
    "      } = await supabase.auth.getSession();",
    "      if (!session) return;",
    "      const res = await fetch(\"/api/modules\", { headers: { Authorization: `Bearer ${session.access_token}` } });",
  ].join("\n");
  const routeText = route.text.replace(getRe, newGet);
  const homeText = home.text.replace(fetchOld, newFetch);
  if (balance(routeText) !== balance(route.text) || balance(homeText) !== balance(home.text)) {
    note("GAGAL", "kunci GET /api/modules: hasil tidak seimbang, TIDAK ditulis");
    return;
  }
  backup(routeRel);
  backup(homeRel);
  writeText(routeRel, routeText, route);
  writeText(homeRel, homeText, home);
  note("OK", "GET /api/modules sekarang wajib login + Homepage mengirim token");
}

function ask(question, def) {
  return new Promise((resolve) => {
    if (!process.stdin.isTTY) return resolve(def);
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    rl.question(question, (a) => {
      rl.close();
      const t = a.trim().toLowerCase();
      resolve(t === "" ? def : t === "y" || t === "ya");
    });
  });
}

// ---------------------------------------------------------------- main
(async function main() {
  console.log("==============================================");
  console.log("  INSTALLER SISTEM ADMIN — demicsystem");
  console.log("==============================================");
  preflight();
  installFiles();
  patchRoutes();
  console.log("\n4) Kunci Bank Modul agar wajib login");
  console.log("   (route GET /api/modules + Homepage.jsx diubah BERSAMAAN; kalau Bank Modul memang publik, jawab n)");
  if (await ask("   Terapkan sekarang? (Y/n): ", true)) lockModules();
  else note("SKIP", "kunci GET /api/modules (dilewati atas pilihanmu)");

  const count = (k) => results.filter((r) => r === k).length;
  console.log("\n==============================================");
  console.log("  Ringkasan: " + count("OK") + " OK, " + count("SKIP") + " dilewati, " + count("WARN") + " peringatan, " + count("GAGAL") + " gagal");
  if (backupDir) console.log("  Cadangan file yang diubah: " + backupDir + "\\  (hapus setelah semuanya berjalan baik)");
  console.log("==============================================");
  if (count("GAGAL") > 0) console.log("\nAda langkah yang gagal — baca baris [GAGAL] di atas lalu kirim ke Claude.");
  console.log("\nLANGKAH BERIKUTNYA (manual):");
  console.log("  1. Supabase > SQL Editor: jalankan admin-setup/admin_setup.sql");
  console.log("     (ganti USERNAME_KAMU dengan username loginmu di bagian 5)");
  console.log("  2. Supabase > Authentication: aktifkan Multi-Factor TOTP");
  console.log("  3. Deploy ke Vercel, login di situs utama, lalu buka /admin");
  process.exit(count("GAGAL") > 0 ? 1 : 0);
})();
