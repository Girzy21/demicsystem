function addImport(text, names) {
  const re = /^import \{([^}]*)\} from "@\/lib\/adminAuth";[ \t]*$/m;
  const m = re.exec(text);
  if (m) {
    const have = m[1].split(",").map((s) => s.trim()).filter(Boolean);
    const all = Array.from(new Set(have.concat(names)));
    return text.replace(m[0], "import { " + all.join(", ") + " } from \"@/lib/adminAuth\";");
  }
  const line = "import { " + names.join(", ") + " } from \"@/lib/adminAuth\";";
  const first = text.search(/^import /m);
  return first < 0 ? line + "\n" + text : text.slice(0, first) + line + "\n" + text.slice(first);
}

function applyStep(text, step) {
  const start = text.search(new RegExp("export async function " + step.fn + "\\s*\\("));
  if (start < 0) return { status: "missing", why: "fungsi " + step.fn + " tidak ditemukan" };
  const nextExport = text.indexOf("\nexport ", start + 10);
  const body = text.slice(start, nextExport < 0 ? text.length : nextExport);
  if (body.includes(step.done)) return { status: "already" };
  const m = step.anchor.exec(body);
  if (!m) return { status: "missing", why: "pola kode tidak cocok (file berbeda dari versi yang saya lihat)" };
  const absStart = start + m.index;
  const insertAt = absStart + m[0].length;
  const lineStart = text.lastIndexOf("\n", absStart) + 1;
  const indent = text.slice(lineStart).match(/^[ \t]*/)[0];
  return { status: "patched", text: text.slice(0, insertAt) + step.insert(indent) + text.slice(insertAt) };
}

function patchRoutes() {
  console.log("\n3) Menambal route yang sudah ada...");
  for (const p of PATCHES) {
    if (!exists(p.file)) {
      note("SKIP", p.file + " (tidak ada)");
      continue;
    }
    try {
      const meta = readText(p.file);
      let text = meta.text;
      let changed = false;
      for (const step of p.steps) {
        const r = applyStep(text, step);
        if (r.status === "patched") {
          text = r.text;
          changed = true;
          note("OK", p.file + " - " + step.label);
        } else if (r.status === "already") note("SKIP", p.file + " - " + step.label + " (sudah ada)");
        else note("GAGAL", p.file + " - " + step.label + ": " + r.why);
      }
      if (!changed) continue;
      text = addImport(text, p.imports);
      if (balance(text) !== balance(meta.text)) {
        note("GAGAL", p.file + " - hasil patch tidak seimbang, TIDAK ditulis");
        continue;
      }
      backup(p.file);
      writeText(p.file, text, meta);
    } catch (e) {
      note("GAGAL", p.file + " - " + e.message);
    }
  }
}

// ---------------------------------------------------------------- 4. kunci GET /api/modules (berpasangan dengan Homepage)
function lockModules() {
  const routeRel = "src/app/api/modules/route.js";
  const homeRel = "src/app/components/Homepage.jsx";
  if (!exists(routeRel) || !exists(homeRel)) {
    note("SKIP", "kunci GET /api/modules (route atau Homepage tidak ditemukan)");
    return;
  }
  const route = readText(routeRel);
  const home = readText(homeRel);
  const routeDone = /export async function GET\(request\)[\s\S]*?authToken/.test(route.text);
  const homeDone = home.text.includes('fetch("/api/modules", { headers');
  if (routeDone && homeDone) {
    note("SKIP", "kunci GET /api/modules (sudah diterapkan)");
    return;
  }
  const getRe = /export async function GET\(\)\s*\{\s*try \{/;
  const fetchOld = 'const res = await fetch("/api/modules");';
  if (!getRe.test(route.text) || home.text.split(fetchOld).length !== 2) {
    note("GAGAL", "kunci GET /api/modules dilewati: pola kode tidak cocok (route dan Homepage harus diubah bersamaan)");
    return;
  }
  const newGet = [
    "export async function GET(request) {",
    "  try {",
    "    // Wajib login: Homepage mengirim token Supabase (lihat fetchModules).",
    "    const authToken = (request.headers.get(\"authorization\") || \"\").replace(/^Bearer\\s+/i, \"\");",
    "    if (!authToken) {",
    "      return NextResponse.json({ error: \"Tidak ada token autentikasi.\" }, { status: 401 });",
    "    }",
    "    const {",
    "      data: { user: authUser },",
    "      error: authErr,",
    "    } = await supabaseAdmin.auth.getUser(authToken);",
    "    if (authErr || !authUser) {",
    "      return NextResponse.json({ error: \"Sesi tidak valid — coba login ulang.\" }, { status: 401 });",
    "    }",
  ].join("\n");
  const newFetch = [
    "const {",
    "        data: { session },",
    "      } = await supabase.auth.getSession();",
    "      if (!session) return;",
    "      const res = await fetch(\"/api/modules\", { headers: { Authorization: `Bearer ${session.access_token}` } });",
  ].join("\n");
  const routeText = route.text.replace(getRe, newGet);
  const homeText = home.text.replace(fetchOld, newFetch);
  if (balance(routeText) !== balance(route.text) || balance(homeText) !== balance(home.text)) {
    note("GAGAL", "kunci GET /api/modules: hasil tidak seimbang, TIDAK ditulis");
    return;
  }
  backup(routeRel);
  backup(homeRel);
  writeText(routeRel, routeText, route);
  writeText(homeRel, homeText, home);
  note("OK", "GET /api/modules sekarang wajib login + Homepage mengirim token");
}


// ---------------------------------------------------------------- 5. menu "People" di Homepage (semua-atau-tidak-sama-sekali)
function insertBeforeFirstImport(text, line) {
  const first = text.search(/^import /m);
  return first < 0 ? line + "\n" + text : text.slice(0, first) + line + "\n" + text.slice(first);
}
function countOf(text, str) {
  return text.split(str).length - 1;
}
function addPeopleMenu() {
  const homeRel = "src/app/components/Homepage.jsx";
  if (!exists(homeRel)) {
    note("SKIP", "menu People (Homepage.jsx tidak ditemukan)");
    return;
  }
  const home = readText(homeRel);
  let t = home.text;
  const alreadyNav = t.includes('key: "people"');
  const alreadyRender = t.includes("<PeopleDirectory");
  if (alreadyNav && alreadyRender) {
    note("SKIP", "menu People (sudah terpasang)");
    return;
  }
  if (alreadyNav !== alreadyRender) {
    note("GAGAL", "menu People terpasang sebagian di Homepage.jsx — periksa manual (cari 'people' / PeopleDirectory)");
    return;
  }

  const NAV = '  { key: "profile", label: "Profile", icon: "\u25D0" },';
  const COPY = '  profile: { title: "Profile", subtitle: "Manage your username, real name (optional), and bio." },';
  const SEARCH = '{activeNav !== "home" && activeNav !== "profile" && (';
  const CTXLINE = "    highlightedModuleId, profileFor, profileSaveError,";
  const RENDER = /\{activeNav === "profile" && \(\s*<div style=\{\{ paddingTop: 4, paddingBottom: 32 \}\}>\s*<ProfileSection ctx=\{ctx\} \/>\s*<\/div>\s*\)\}/;

  const problems = [];
  if (countOf(t, NAV) !== 1) problems.push("NAV_ITEMS");
  if (countOf(t, COPY) !== 1) problems.push("TOPBAR_COPY");
  if (countOf(t, SEARCH) !== 1) problems.push("kolom cari TopBar");
  if (countOf(t, CTXLINE) !== 1) problems.push("ctx");
  const rm = RENDER.exec(t);
  if (!rm) problems.push("render section profile");
  if (problems.length) {
    note("GAGAL", "menu People dilewati (tidak ada yang diubah) - pola tidak cocok: " + problems.join(", "));
    return;
  }

  t = t.replace(NAV, '  { key: "people", label: "People", icon: "\u25CE" },\n' + NAV);
  t = t.replace(COPY, '  people: { title: "People", subtitle: "Discover students across the school \u2014 interests, skills, and what they are working on." },\n' + COPY);
  t = t.replace(SEARCH, '{activeNav !== "home" && activeNav !== "profile" && activeNav !== "people" && (');
  t = t.replace(CTXLINE, CTXLINE + " profilesByUsername, UsernameAvatar,");
  const rm2 = RENDER.exec(t);
  const lineStart = t.lastIndexOf("\n", rm2.index) + 1;
  const ind = t.slice(lineStart).match(/^[ \t]*/)[0];
  const block = [
    '{activeNav === "people" && (',
    ind + '  <div style={{ paddingTop: 4, paddingBottom: 32 }}>',
    ind + "    <PeopleDirectory ctx={ctx} />",
    ind + "  </div>",
    ind + ")}",
    ind,
  ].join("\n");
  t = t.slice(0, rm2.index) + block + t.slice(rm2.index);
  t = insertBeforeFirstImport(t, 'import PeopleDirectory from "./PeopleDirectory";');

  if (balance(t) !== balance(home.text)) {
    note("GAGAL", "menu People: hasil tidak seimbang, TIDAK ditulis");
    return;
  }
  backup(homeRel);
  writeText(homeRel, t, home);
  note("OK", "menu People ditambahkan ke Homepage.jsx (NAV_ITEMS, TopBar, render, ctx, import)");
}

// ---------------------------------------------------------------- 6. petunjuk tautan "Lupa password"
function walkSrc(dir, out, depth) {
  if (depth > 6 || out.length > 400) return;
  let entries = [];
  try {
    entries = fs.readdirSync(dir, { withFileTypes: true });
  } catch (e) {
    return;
  }
  for (const en of entries) {
    if (en.name === "node_modules" || en.name === ".next" || en.name.startsWith("_admin-backup")) continue;
    const full = path.join(dir, en.name);
    if (en.isDirectory()) walkSrc(full, out, depth + 1);
    else if (/\.(jsx|tsx|js|ts)$/.test(en.name)) out.push(full);
  }
}


