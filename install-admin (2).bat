function ensureBrandImport(text, names) {
  const re = /^import \{([^}]*)\} from "@\/app\/brand";[ \t]*$/m;
  const m = re.exec(text);
  if (m) {
    const have = m[1].split(",").map((x) => x.trim()).filter(Boolean);
    const all = Array.from(new Set(have.concat(names)));
    return text.replace(m[0], "import { " + all.join(", ") + " } from \"@/app/brand\";");
  }
  return insertBeforeFirstImport(text, "import { " + names.join(", ") + " } from \"@/app/brand\";");
}

function applyEdits(rel, edits, importNames) {
  const meta = readText(rel);
  let t = meta.text;
  let changed = false;
  for (const e of edits) {
    if (e.done(t)) {
      note("SKIP", rel + " - " + e.name + " (sudah)");
      continue;
    }
    const out = e.apply(t);
    if (out === null || out === t) {
      note("GAGAL", rel + " - " + e.name + ": pola kode tidak cocok (file berbeda dari versi yang saya lihat)");
      continue;
    }
    t = out;
    changed = true;
    note("OK", rel + " - " + e.name);
  }
  if (!changed) return;
  const body = t.replace(/^import \{[^}]*\} from "@\/app\/brand";[ \t]*\n?/m, "");
  const used = importNames.filter((n) => new RegExp("\\b" + n + "\\b").test(body));
  if (used.length) t = ensureBrandImport(t, used);
  if (balance(t) !== balance(meta.text)) {
    note("GAGAL", rel + " - hasil tidak seimbang, TIDAK ditulis");
    return;
  }
  backup(rel);
  writeText(rel, t, meta);
}

const SANS_LITERAL = "\"'Helvetica Neue', Arial, sans-serif\"";
const SERIF_LITERAL = "\"'Georgia', 'Iowan Old Style', serif\"";
const LOGO_RE = /(linear-gradient\(135deg, #2C7BE5, #6FB3E8\)`(?:(?!\}\})[\s\S])*\}\}\s*>\s*)\?(\s*<\/div>)/g;

function replaceOnce(re, replacement) {
  return (t) => {
    const hits = t.match(new RegExp(re.source, re.flags.includes("g") ? re.flags : re.flags + "g"));
    if (!hits || hits.length !== 1) return null;
    return t.replace(re, replacement);
  };
}
const fontEdit = {
  name: "font Inter + Space Grotesk",
  done: (t) => t.includes("SANS_STACK"),
  apply: (t) => {
    if (!t.includes(SANS_LITERAL) && !t.includes(SERIF_LITERAL)) return null;
    return t.split(SANS_LITERAL).join("SANS_STACK").split(SERIF_LITERAL).join("HEADING_STACK");
  },
};
// Semua kotak logo "?" diganti (halaman login punya dua: header dan layar "Memuat...").
const logoEdit = {
  name: "logo w3study",
  done: (t) => t.includes("<W3Mark"),
  apply: (t) => {
    const re = new RegExp(LOGO_RE.source, "g");
    if (!re.test(t)) return null;
    return t.replace(new RegExp(LOGO_RE.source, "g"), (m, a, b) => a + "<W3Mark size={18} />" + b);
  },
};
const BRAND_NAMES = ["SANS_STACK", "HEADING_STACK", "BRAND_NAME", "W3Mark"];

function findLoginFile() {
  for (const rel of ["src/app/page.jsx", "src/app/page.js", "src/app/page.tsx"]) {
    if (exists(rel) && /signInWithPassword/.test(fs.readFileSync(abs(rel), "utf8"))) return rel;
  }
  const files = [];
  walkSrc(path.join(ROOT, "src"), files, 0);
  for (const f of files) {
    try {
      if (fs.statSync(f).size > 600000) continue;
      const rel = path.relative(ROOT, f).replace(/\\/g, "/");
      if (/signInWithPassword/.test(fs.readFileSync(f, "utf8")) && !/api\/admin/.test(rel)) return rel;
    } catch (e) {}
  }
  return null;
}

function patchBrand() {
  const loginRel = findLoginFile();
  if (!loginRel) {
    note("WARN", "file login tidak ditemukan otomatis — tautan Lupa password, penghapusan teks demo, dan merek di halaman login dilewati");
  } else {
    applyEdits(
      loginRel,
      [
        {
          name: "tautan 'Lupa password?'",
          done: (t) => t.includes('href="/lupa-password"'),
          apply: replaceOnce(
            /(Tetap masuk\s*<\/label>)(\s*<\/div>)/,
            (m, a, b) =>
              a +
              '\n                  <a href="/lupa-password" style={{ fontFamily: sans, fontSize: 12, fontWeight: 600, color: c.blue, textDecoration: "none" }}>\n                    Lupa password?\n                  </a>' +
              b
          ),
        },
        {
          name: "hapus teks 'Coba demo'",
          done: (t) => !t.includes("Coba demo"),
          apply: replaceOnce(/\n[ \t]*<div style=\{\{[^\n]*\}\}>\s*Coba demo: username[\s\S]*?<\/div>[ \t]*(?=\n)/, () => ""),
        },
        {
          name: "nama w3study",
          done: (t) => !t.includes("[Nama Website]"),
          apply: replaceOnce(
            /\[Nama Website\] <span style=\{\{ opacity: 0\.45, fontWeight: 400 \}\}>[^<]*placeholder<\/span>/,
            () => "<span style={{ fontFamily: HEADING_STACK, fontSize: 17, letterSpacing: -0.3 }}>{BRAND_NAME}</span>"
          ),
        },
        logoEdit,
        fontEdit,
      ],
      BRAND_NAMES
    );
  }

  const homeRel = "src/app/components/Homepage.jsx";
  if (!exists(homeRel)) {
    note("SKIP", "merek di Homepage (Homepage.jsx tidak ditemukan)");
    return;
  }
  applyEdits(
    homeRel,
    [
      {
        name: "nama w3study di sidebar",
        done: (t) => !t.includes("[Website Name]"),
        apply: replaceOnce(
          /\[Website Name\] <br \/>(\s*)<span style=\{\{ opacity: 0\.45, fontWeight: 400, fontSize: 11 \}\}>placeholder<\/span>/,
          (m, ws) =>
            "<span style={{ fontFamily: HEADING_STACK, fontSize: 16, letterSpacing: -0.3 }}>{BRAND_NAME}</span> <br />" +
            ws +
            "<span style={{ opacity: 0.45, fontWeight: 400, fontSize: 11 }}>academic ecosystem</span>"
        ),
      },
      logoEdit,
      fontEdit,
      {
        name: "tautan 'Ganti password' di Profile",
        done: (t) => t.includes('href="/ganti-password"'),
        apply: replaceOnce(
          /(\{isOwnProfile && !editingProfile && \(\s*<button\s+onClick=\{startEditingProfile\}[\s\S]*?Edit profil\s*<\/button>\s*\)\})/,
          (m) =>
            m +
            '\n        {isOwnProfile && !editingProfile && (\n          <a href="/ganti-password" style={{ display: "block", marginTop: 10, textAlign: "center", fontFamily: sans, fontSize: 11.5, color: c.inkMuted, textDecoration: "none" }}>\n            Ganti password\n          </a>\n        )}'
        ),
      },
    ],
    BRAND_NAMES
  );
}

// Judul & deskripsi tab di layout root (hanya kalau masih bawaan/placeholder).
function patchLayout() {
  const rel = ["src/app/layout.jsx", "src/app/layout.js", "src/app/layout.tsx", "src/app/layout.ts"].find(exists);
  if (!rel) {
    note("WARN", "layout root tidak ditemukan — isi title situs manual: title: \"w3study\"");
    return;
  }
  const meta = readText(rel);
  const mm = /export const metadata\s*(?::[^=]+)?=\s*\{[\s\S]*?\n\}/.exec(meta.text);
  if (!mm) {
    note("WARN", rel + ": blok 'export const metadata' tidak ditemukan — isi title situs manual: title: \"w3study\"");
    return;
  }
  const block = mm[0];
  let nb = block;
  const tm = /title:\s*(["'])(.*?)\1/.exec(block);
  if (!tm) nb = nb.replace("{", "{\n  title: \"w3study\",");
  else if (/create next app|placeholder|nama website|website name|^\s*$/i.test(tm[2])) nb = nb.replace(tm[0], "title: \"w3study\"");
  else if (tm[2] !== "w3study") note("INFO", rel + ": title sudah diisi (\"" + tm[2] + "\"), tidak diubah");
  const dm = /description:\s*(["'])(.*?)\1/.exec(nb);
  if (dm && /generated by create next app|placeholder|^\s*$/i.test(dm[2])) {
    nb = nb.replace(dm[0], "description: \"w3study \\u2014 ekosistem akademik sekolah: bank modul, forum diskusi, dan profil.\"");
  }
  if (nb === block) {
    if (tm && tm[2] === "w3study") note("SKIP", rel + " - judul tab (sudah w3study)");
    return;
  }
  const text = meta.text.replace(block, nb);
  if (balance(text) !== balance(meta.text)) {
    note("GAGAL", rel + " - hasil tidak seimbang, TIDAK ditulis");
    return;
  }
  backup(rel);
  writeText(rel, text, meta);
  note("OK", rel + " - judul tab: w3study");
}

function ask(question, def) {
  return new Promise((resolve) => {
    if (!process.stdin.isTTY) return resolve(def);
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    rl.question(question, (a) => {
      rl.close();
      const t = a.trim().toLowerCase();
      resolve(t === "" ? def : t === "y" || t === "ya");
    });
  });
}

